if(NOT EXISTS "@inner_build@/cmake_install.cmake")
    message(FATAL_ERROR "ARM-VO has not been built. Run make before make install.")
endif()
set(arguments --install "@inner_build@" --prefix "${CMAKE_INSTALL_PREFIX}")
set(manifest "@inner_build@/install_manifest.txt")
if(CMAKE_INSTALL_COMPONENT)
    list(APPEND arguments --component "${CMAKE_INSTALL_COMPONENT}")
    set(manifest "@inner_build@/install_manifest_${CMAKE_INSTALL_COMPONENT}.txt")
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" ${arguments} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ARM-VO installation failed")
endif()
file(STRINGS "${manifest}" CMAKE_INSTALL_MANIFEST_FILES ENCODING UTF-8)
